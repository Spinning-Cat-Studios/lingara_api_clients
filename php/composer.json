{
    "name": "spinningcatstudios/lingara",
    "description": "The official PHP library for the Lingara API: PSR-18 calls, foreach event streams, and OAuth client credentials.",
    "type": "library",
    "license": "MIT",
    "keywords": ["lingara", "language-learning", "api", "psr-18", "server-sent-events"],
    "homepage": "https://getlingara.com",
    "require": {
        "php": ">=8.2",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1.29",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/http-client": "^7.1"
    },
    "suggest": {
        "symfony/http-client": "Streams events in real time; install with nyholm/psr7 (the recommended stack)",
        "nyholm/psr7": "The PSR-17 factories the Symfony stack builds on",
        "guzzlehttp/guzzle": "Streams events in real time when allow_url_fopen is on"
    },
    "conflict": {
        "guzzlehttp/guzzle": "<7.9",
        "symfony/http-client": "<7.1"
    },
    "autoload": {
        "psr-4": {
            "Lingara\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lingara\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
