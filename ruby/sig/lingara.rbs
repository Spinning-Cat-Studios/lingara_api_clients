module Lingara
  VERSION: String
  GEM_VERSION: String
  GENERATED_FOR_VERSION: String
  OPERATIONS: Hash[String, Hash[Symbol, untyped]]

  type seconds = Integer | Float
  type event = untyped

  interface _TokenSource
    def token: () -> AccessToken
    def invalidate: (AccessToken token) -> void
  end

  interface _Logger
    def warn: (String message) -> untyped
    def debug: (String message) -> untyped
  end

  class Client
    DEFAULT_BASE_URL: String
    DEFAULT_TOKEN_URL: String

    attr_reader token_source: _TokenSource?

    def initialize: (
      ?client_id: String?,
      ?client_secret: String?,
      ?auth: (:basic | :post)?,
      ?scopes: Array[String]?,
      ?token_source: _TokenSource?,
      ?base_url: String,
      ?token_url: String,
      ?version: String?,
      ?on_deprecation: (^(DeprecationNotice) -> void)?,
      ?logger: _Logger,
      ?max_attempts: Integer,
      ?retry_after_cap: seconds,
      ?stream_idle_timeout: seconds,
      ?token_request_timeout: seconds,
      ?user_agent_suffix: String?,
      ?clock: ^() -> Time,
      ?sleeper: ^(seconds) -> void,
      ?net_http_options: Hash[Symbol, untyped],
      ?tail_max_failures: Integer
    ) -> void

    def generate_vocabulary: (**untyped body) { (event) -> void } -> StreamResult
                           | (**untyped body) -> EventStream
    def create_lesson_plan: (**untyped body) { (event) -> void } -> StreamResult
                          | (**untyped body) -> EventStream
    def get_lesson_plan: (String plan_id) -> Response
    def stream_lesson_plan: (String plan_id) { (event) -> void } -> StreamResult
                          | (String plan_id) -> EventStream
    def send_tutor_message: (**untyped body) { (event) -> void } -> StreamResult
                          | (**untyped body) -> EventStream
    def get_usage: () -> Response
    def get_open_api_document: () -> Response
    def list_api_versions: () -> Response
    def get_api_version: (String version_id) -> Response
    def get_async_api_document: () -> Response
    def list_events: (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?, ?limit: Integer?) -> Response
    def events: (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?) { (Events::Event) -> void } -> Events::Feed
              | (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?) -> Events::Feed
    def stream_events: (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?, ?last_event_id: String?) { (event) -> void } -> StreamResult
                     | (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?, ?last_event_id: String?) -> EventStream
    def tail_events: (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?) { (Events::Event) -> void } -> bot
                   | (?cursor: String?, ?start: (String | Symbol)?, ?types: Array[String]?) -> Events::Tail
    def send_event: (Events::InboundEvent event, ?idempotency_key: String?) -> Response

    # ADR 1.10.26w: embedding. create_embed_token's Response holds a MintedToken.
    def create_embed_token: (**untyped body) -> Response
    def delete_embed_player: (String player_ref) -> Response
    # ADR 22.10.26t: link_embed_player's Response holds an EmbedPlayerLink.
    def link_embed_player: (String player_ref) -> Response
    def unlink_embed_player: (String player_ref) -> Response
    def send_dialogue_turn: (**untyped body) { (event) -> void } -> StreamResult
    # ADR 16.10.26ak: the canvas operations, as a group.
    def canvases: () -> Canvases
    # ADR 29.10.26c: the stored-dialogue operations, as a group.
    def dialogues: () -> Dialogues
  end

  class Dialogues
    def initialize: (^(String, Array[String], Hash[Symbol, untyped]?, untyped) -> Response request,
                     ^(Array[String], Hash[Symbol, String?], Hash[String, String]) -> Response export) -> void
    def list_dialogues: (?cursor: String?, ?limit: Integer?, ?name: String?) -> Response
    def create_dialogue: (Hash[untyped, untyped] body) -> Response
    def get_dialogue: (String dialogue_id) -> Response
    def rename_dialogue: (String dialogue_id, Hash[untyped, untyped] body) -> Response
    def save_dialogue_draft: (String dialogue_id, Hash[untyped, untyped] body) -> Response
    def activate_dialogue: (String dialogue_id, Hash[untyped, untyped] body) -> Response
    # The Response's value is an ExportedDialogue::Body or ::NotModified.
    def export_dialogue: (String dialogue_id, ?revision: String?, ?layout: String?, ?if_none_match: String?) -> Response
    def page_dialogues: (**untyped filters) { (untyped) -> void } -> untyped
                      | (**untyped filters) -> Enumerator[untyped, untyped]
  end

  # ADR 29.10.26c D6: the export's two arms.
  module ExportedDialogue
    def self.from: (untyped response) -> (Body | NotModified)

    class Body < ::Data
      attr_reader revision: Integer
      attr_reader etag: String
      attr_reader ir_json: String
      def initialize: (revision: Integer, etag: String, ir_json: String) -> void
    end

    class NotModified < ::Data
      attr_reader revision: Integer
      attr_reader etag: String
      def initialize: (revision: Integer, etag: String) -> void
    end
  end

  class Canvases
    def initialize: (^(String, Array[String], Hash[Symbol, untyped]?, untyped) -> Response request) -> void
    def list_canvases: (?cursor: String?, ?limit: Integer?, ?name: String?, ?status: String?, ?recipes: Array[String]?, ?kinds: Array[String]?, ?scopes: Array[String]?) -> Response
    def create_canvas: (Hash[untyped, untyped] body) -> Response
    def get_canvas: (String canvas_id) -> Response
    def rename_canvas: (String canvas_id, Hash[untyped, untyped] body) -> Response
    def save_canvas_draft: (String canvas_id, Hash[untyped, untyped] body) -> Response
    def activate_canvas: (String canvas_id, Hash[untyped, untyped] body) -> Response
    def dry_run_canvas_plan: (Hash[untyped, untyped] body) -> Response
    def page_canvases: (**untyped filters) { (untyped) -> void } -> untyped
                     | (**untyped filters) -> Enumerator[untyped, untyped]
  end

  class MintedToken
    PREFIX: String
    FIELDS: Hash[String, untyped]

    attr_reader token: AccessToken
    attr_reader expires_at: Time
    attr_reader expires_in: Integer
    attr_reader subject: String
    attr_reader scopes: Array[String]
    attr_reader account_linked: bool
    # ADR 31.10.26g: an UpdateAvailable or nil, untyped as every generated model is.
    attr_reader update_available: untyped
    MESSAGE_MAX: Integer

    def self.decode: (String body) -> MintedToken
    def initialize: (token: AccessToken, expires_at: Time, expires_in: Integer, subject: String, scopes: Array[String], account_linked: bool, ?update_available: untyped) -> void
  end

  # ADR 30.9.26aa: the event union, the verifier, the feed and the tail.
  module Events
    ENVELOPE: Array[Symbol]

    # Every arm, UnknownEvent included. Each is a Data with these members.
    module Event
      ARMS: Hash[String, [Class, String?]]

      def id: () -> String
      def type: () -> String
      def created_at: () -> Time
      def api_version: () -> String
      def subject: () -> String
      def data: () -> untyped
    end

    class LessonPlanReady < ::Data
      include Event
    end

    class LessonPlanFailed < ::Data
      include Event
    end

    class UsageThresholdReached < ::Data
      include Event
    end

    class WebhookTest < ::Data
      include Event
    end

    class AppInstalled < ::Data
      include Event
    end

    class AppUninstalled < ::Data
      include Event
    end

    class AppDisabled < ::Data
      include Event
    end

    class AppEnabled < ::Data
      include Event
    end

    class PracticeCompleted < ::Data
      include Event
    end

    class UnknownEvent < ::Data
      include Event
    end

    class InboundEvent
      CONSTRUCTORS: Hash[String, Symbol]

      attr_reader type: String
      attr_reader data: untyped

      def self.world_context_changed: (untyped data) -> InboundEvent
      def self.world_practice_requested: (untyped data) -> InboundEvent
      def self.world_practice_completed: (untyped data) -> InboundEvent
      def to_hash: () -> Hash[String, untyped]
    end

    def self.parse: (String json) -> Event
    def self.decode: (Hash[String, untyped] fields) -> Event

    class VerificationError < StandardError
      REASONS: Array[Symbol]

      attr_reader reason: :missing_header | :malformed_header | :timestamp_too_old | :timestamp_too_new | :no_matching_signature | :malformed_payload

      def initialize: (Symbol reason, String detail) -> void
    end

    class Webhook
      PREFIX: String
      MIN_KEY_BYTES: Integer
      TOLERANCE: Integer
      HEADERS: Array[String]

      def initialize: (String | Array[String] secret_or_secrets, ?clock: ^() -> Time) -> void
      def verify: (String body, _Each[[untyped, untyped]] headers) -> Event
      def verify_signature: (String body, _Each[[untyped, untyped]] headers) -> nil
      def self.key: (String secret) -> String
      def self.header: (_Each[[untyped, untyped]] headers, String name) -> String
      def self.strict_base64: (String text) -> String?
    end

    class Feed
      include Enumerable[Event]

      attr_reader cursor: String?

      def each: () { (Event) -> void } -> self
              | () -> Enumerator[Event, self]
    end

    class Tail
      include Enumerable[Event]

      MAX_DELAY: Integer

      attr_reader cursor: String?

      def each: () { (Event) -> void } -> bot
              | () -> Enumerator[Event, bot]
    end
  end

  class Response
    attr_reader value: untyped
    attr_reader served_version: String?
  end

  class StreamResult
    attr_reader served_version: String?
  end

  class EventStream
    include Enumerable[event]

    attr_reader served_version: String?

    def each: () { (event) -> void } -> self
            | () -> Enumerator[event, self]
    def next: () -> event
    def close: () -> nil
  end

  class AccessToken
    def initialize: (String raw) -> void
    def expose_secret: () -> String
  end

  class ClientCredentials
    attr_reader client_id: String

    def token: () -> AccessToken
    def invalidate: (AccessToken token) -> void
    def expose_secret: () -> String
  end

  class DeprecationLink
    attr_reader raw: String
    attr_reader target: untyped
  end

  class DeprecationNotice
    attr_reader version: String?
    attr_reader deprecated_at: Time?
    attr_reader sunset_at: Time?
    attr_reader link: DeprecationLink?
    attr_reader headers: Hash[String, String]
  end

  class DefaultLogger
    def warn: (String message) -> void
    def debug: (String message) -> void
  end

  class Error < StandardError
  end

  class ApiError < Error
    attr_reader status: Integer
    attr_reader code: String
    attr_reader retry_after: Integer?
    attr_reader plan_id: String?
    attr_reader served_version: String?
  end

  class OAuthError < Error
    attr_reader status: Integer
    attr_reader error: String
    attr_reader description: String?
    attr_reader retry_after: Integer?
  end

  class MaintenanceError < Error
    attr_reader body: String
    attr_reader retry_after: Integer?
  end

  class TransportError < Error
    KINDS: Array[Symbol]

    attr_reader kind: :connect | :tls | :reset | :timeout | :stream_ended_early | :malformed_response | :malformed_event
  end

  class SSEDecoder
    class Frame
      attr_reader event: String
      attr_reader data: String
      attr_reader id: String?
    end

    def feed: (String bytes) -> Array[Frame]
    def finish: () -> Array[Frame]
  end
end
