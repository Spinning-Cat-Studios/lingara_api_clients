{
  "openapi": "3.0.3",
  "info": { "title": "Fixture", "version": "2026-09-fixture-view" },
  "paths": {
    "/v1/a": { "get": { "operationId": "getA", "security": [{ "oauth2": ["a:read"] }], "responses": { "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Thing" } } } } } } },
    "/v1/b/{id}": { "get": { "operationId": "getB", "security": [{ "oauth2": ["b:read"] }] } },
    "/v1/c": { "get": { "operationId": "getC", "security": [], "responses": { "200": { "content": { "application/json": { "schema": { "type": "object" } } } } } } },
    "/v1/d": { "parameters": [], "put": { "operationId": "putD", "security": [], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Thing" } } } } } }
  },
  "x-lingara-streams": [
    {
      "operationId": "streamWords",
      "method": "post",
      "path": "/v1/words/stream",
      "requestBody": "#/components/schemas/WordsRequest",
      "scopes": ["words:generate"],
      "union": "StreamWordsEvent",
      "events": ["started", "word", "done", "error"],
      "endsOn": ["done", "error"],
      "error": "error"
    },
    {
      "operationId": "followPlan",
      "method": "get",
      "path": "/v1/plans/{id}/stream",
      "requestBody": null,
      "scopes": ["plans:read"],
      "union": "FollowPlanEvent",
      "events": ["phase", "result", "pending", "error"],
      "endsOn": ["result", "pending", "error"],
      "error": "error"
    }
  ],
  "x-lingara-events": [
    { "type": "word.ready", "direction": "out", "arm": "WordReady", "data": "#/components/schemas/WordReadyData", "transports": ["feed", "webhook"] },
    { "type": "ping.test", "direction": "out", "arm": "PingTest", "data": "#/components/schemas/Thing", "transports": ["webhook"] },
    { "type": "world.moved", "direction": "in", "data": "#/components/schemas/WorldMoved", "transports": ["inbound"] }
  ],
  "components": {
    "schemas": {
      "Thing": { "type": "object" },
      "WordReadyData": { "type": "object", "properties": { "word": { "type": "string" } }, "required": ["word"] },
      "WorldMoved": { "type": "object", "properties": { "place": { "type": "string" } }, "required": ["place"] },
      "WordsRequest": { "type": "object" },
      "Done": { "type": "object" },
      "StreamWordsEvent": {
        "oneOf": [
          { "$ref": "#/components/schemas/StreamWordsEventStarted" },
          { "$ref": "#/components/schemas/StreamWordsEventWord" },
          { "$ref": "#/components/schemas/StreamWordsEventDone" },
          { "$ref": "#/components/schemas/StreamWordsEventError" }
        ],
        "discriminator": {
          "propertyName": "event",
          "mapping": {
            "started": "#/components/schemas/StreamWordsEventStarted",
            "word": "#/components/schemas/StreamWordsEventWord",
            "done": "#/components/schemas/StreamWordsEventDone",
            "error": "#/components/schemas/StreamWordsEventError"
          }
        }
      },
      "StreamWordsEventStarted": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Started" } } },
      "StreamWordsEventWord": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Word" } } },
      "StreamWordsEventDone": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Done" } } },
      "StreamWordsEventError": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/StreamError" } } },
      "FollowPlanEvent": {
        "oneOf": [
          { "$ref": "#/components/schemas/FollowPlanEventPhase" },
          { "$ref": "#/components/schemas/FollowPlanEventResult" },
          { "$ref": "#/components/schemas/FollowPlanEventPending" },
          { "$ref": "#/components/schemas/FollowPlanEventError" }
        ],
        "discriminator": {
          "propertyName": "event",
          "mapping": {
            "phase": "#/components/schemas/FollowPlanEventPhase",
            "result": "#/components/schemas/FollowPlanEventResult",
            "pending": "#/components/schemas/FollowPlanEventPending",
            "error": "#/components/schemas/FollowPlanEventError"
          }
        }
      },
      "FollowPlanEventPhase": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Phase" } } },
      "FollowPlanEventResult": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Result" } } },
      "FollowPlanEventPending": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Pending" } } },
      "FollowPlanEventError": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/StreamError" } } }
    }
  }
}
