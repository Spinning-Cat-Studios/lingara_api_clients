{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "typeRoots": ["../../typescript/node_modules/@types"],
    "types": ["node"],
    "paths": { "@lingara/api": ["../../typescript/dist/index.d.ts"] }
  },
  "include": ["*.ts"]
}
